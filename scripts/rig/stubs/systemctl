#!/bin/bash
# systemctl stub（台架用）：记录每次调用，模拟最小状态。
# 状态文件：/root/rig/state/<unit>.<active|enabled>，内容 yes/no。
LOG=/root/rig/logs/calls.log
STATE=/root/rig/state
echo "$(date '+%H:%M:%S') systemctl $*" >> "$LOG"
unit_state() { # $1=unit $2=field
  [ -f "$STATE/$1.$2" ] && cat "$STATE/$1.$2" || echo ""
}
kill_stub_holder() {
  # 模拟 resolved 停掉 stub：干掉占着 127.0.0.53:53 的 bindhold（按 PID 文件，不用模式匹配）
  if [ -f "$STATE/stub-holder.pid" ]; then
    kill "$(cat "$STATE/stub-holder.pid")" 2>/dev/null || true
    rm -f "$STATE/stub-holder.pid"
  fi
}
case "$1" in
  is-active)
    shift; [ "$1" = "--quiet" ] && shift
    [ "$(unit_state "$1" active)" = "yes" ] && exit 0 || exit 3
    ;;
  is-enabled)
    shift; [ "$1" = "--quiet" ] && shift
    [ "$(unit_state "$1" enabled)" = "yes" ] && exit 0 || exit 1
    ;;
  restart)
    # restart <unit>；resolved 重启时 stub 监听随之释放。
    # F3-02：install.sh 重装时对已运行的 agent/proxy 用 restart——stub
    # 必须模拟 systemd 的 stop+start 语义（先杀旧进程、再按新配置起
    # 新进程），只记一条 markers 不算重启：run_install 停掉上个场景
    # 的 agent 后只删 PID 文件、不复位 active 状态，S5 的 [3/6] 走
    # restart 分支时若不真起 agent，[4/6] 验证必然失败（143/4 的
    # 3 个 S5 FAIL 即此 stub 缺口，不是产品 bug——真 systemd 的
    # restart 本来就会重起进程）。
    [ "$2" = "systemd-resolved" ] && kill_stub_holder
    echo "restart $2" >> /root/rig/logs/markers.log
    if [ "$2" = "dnsunlock-agent" ]; then
      if [ -f "$STATE/agent.pid" ]; then
        kill "$(cat "$STATE/agent.pid")" 2>/dev/null || true
        sleep 1
        rm -f "$STATE/agent.pid"
      fi
      echo "yes" > "$STATE/$2.active"
      /root/rig/stubs/start-agent
    fi
    exit 0
    ;;
  stop)
    # stop <unit>；P1 (v0.1.6) 还原前先停 agent：真杀掉台架里的 agent
    #（按 PID 文件，和 rig-inner.sh 的 stop_agent 同款），并把状态记停。
    u="$2"
    echo "stop $u" >> /root/rig/logs/markers.log
    if [ "$u" = "dnsunlock-agent" ]; then
      if [ -f "$STATE/agent.pid" ]; then
        kill "$(cat "$STATE/agent.pid")" 2>/dev/null || true
        sleep 1
        rm -f "$STATE/agent.pid"
      fi
      echo "no" > "$STATE/$u.active"
    fi
    exit 0
    ;;
  start)
    # start <unit>；P1 (v0.1.6) 还原后按需恢复 agent：走 start-agent 真起。
    u="$2"
    echo "start $u" >> /root/rig/logs/markers.log
    if [ "$u" = "dnsunlock-agent" ]; then
      echo "yes" > "$STATE/$u.active"
      /root/rig/stubs/start-agent
    fi
    exit 0
    ;;
  reload)
    echo "reload $2" >> /root/rig/logs/markers.log
    exit 0
    ;;
  disable)
    u="${*: -1}"
    [ "$u" = "systemd-resolved" ] && kill_stub_holder
    echo "no" > "$STATE/$u.active"; echo "no" > "$STATE/$u.enabled"
    echo "disable $u" >> /root/rig/logs/markers.log
    exit 0
    ;;
  enable)
    u="${*: -1}"
    echo "yes" > "$STATE/$u.active"; echo "yes" > "$STATE/$u.enabled"
    echo "enable $u" >> /root/rig/logs/markers.log
    if [ "$u" = "dnsunlock-agent" ]; then
      # 模拟 systemd 启动 agent：按 install.sh 刚写的配置起真 agent
      /root/rig/stubs/start-agent
    fi
    exit 0
    ;;
  daemon-reload) exit 0;;
  status)
    echo "stub: ${2:-} active (running)"; exit 0;;
  cat)
    case "$2" in systemd-resolved.service|NetworkManager.service|dnsunlock-agent.service) exit 0;; *) exit 1;; esac
    ;;
  list-unit-files) exit 0;;
  *) exit 0;;
esac
